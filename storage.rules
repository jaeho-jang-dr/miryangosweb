rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Voice Charts (High Privacy) — Authenticated users only
    match /voice-charts/{patientId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Default: Authenticated users only
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
