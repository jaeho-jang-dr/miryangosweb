rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Voice Charts (High Privacy) — Authenticated users only
    match /voice-charts/{patientId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Uploads (General files) — Authenticated users only
    match /uploads/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.size < 50 * 1024 * 1024; // 50MB limit
    }

    // Images (Processed images) — Authenticated users only
    match /images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.size < 20 * 1024 * 1024 // 20MB limit
                   && request.resource.contentType.matches('image/.*');
    }

    // Articles (Blog attachments) — Authenticated users only
    match /articles/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.size < 100 * 1024 * 1024; // 100MB limit
    }

    // Default: Authenticated users only
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
