# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Firebase service account (contains sensitive credentials)
firebase-service-account.json

# vercel
.vercel

# typescript
*.tsbuildinfo

# user uploads
/public/uploads
/public/temp

# Claude AI configuration and guides
.claude/
!.claude/project-config.json
!.claude/README.md
CLAUDE_SETUP_GUIDE.md

# Firebase logs and config
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Noterang (NotebookLM Automation)
**/__pycache__/
*.py[cod]
*$py.class
apps/noterang/*.png
apps/noterang/CCimages/
apps/noterang/downloads/
apps/noterang/browser_profile*/
noterang_config.json

# Local temporary files and artifacts
temp/
*.zip
*.log
nul
**/nul
.git_backup
.env.local
.env.*.local

# IDEs
.vscode/
.idea/
*.swp
*.swo



