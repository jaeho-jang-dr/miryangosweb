{
  "name": "miryangosweb",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "claude": "bash start-claude.sh",
    "claude:proxy": "antigravity-claude-proxy",
    "drjay": "node scripts/drjay-assistant.js",
    "deploy": "node scripts/firebase-deploy.js",
    "deploy:hosting": "node scripts/firebase-deploy.js --target=hosting",
    "deploy:firestore": "node scripts/firebase-deploy.js --target=firestore",
    "deploy:storage": "node scripts/firebase-deploy.js --target=storage",
    "deploy:all": "node scripts/firebase-deploy.js --target=all",
    "deploy:dry-run": "node scripts/firebase-deploy.js --dry-run",
    "deploy:dev": "node scripts/deploy-env.js --development",
    "deploy:staging": "node scripts/deploy-env.js --staging",
    "deploy:prod": "node scripts/deploy-env.js --production",
    "deploy:staging:dry-run": "node scripts/deploy-env.js --staging --dry-run",
    "deploy:prod:dry-run": "node scripts/deploy-env.js --production --dry-run",
    "sync": "powershell -ExecutionPolicy Bypass -File scripts/smart-sync.ps1 status",
    "sync:push": "powershell -ExecutionPolicy Bypass -File scripts/smart-sync.ps1 push",
    "sync:pull": "powershell -ExecutionPolicy Bypass -File scripts/smart-sync.ps1 pull",
    "sync:push:all": "powershell -ExecutionPolicy Bypass -File scripts/smart-sync.ps1 push -All",
    "sync:setup": "powershell -ExecutionPolicy Bypass -File scripts/smart-sync.ps1 setup",
    "sync:dry": "powershell -ExecutionPolicy Bypass -File scripts/smart-sync.ps1 push -DryRun",
    "emr:dev": "cd apps/miryangosemr && npm run dev",
    "emr:build": "cd apps/miryangosemr && npm run build",
    "emr:start": "cd apps/miryangosemr && npm run start",
    "deploy:emr": "cd apps/miryangosemr && npm run build && cd ../.. && firebase deploy --only hosting:emr"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/generative-ai": "^0.24.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/gm": "^1.25.4",
    "@types/three": "^0.182.0",
    "axios": "^1.13.2",
    "blessed": "^0.1.81",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.3.5",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^12.24.7",
    "gm": "^1.25.1",
    "iconv-lite": "^0.7.2",
    "inquirer": "^13.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "next": "16.1.1",
    "openai": "^6.16.0",
    "ora": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "pdf2pic": "^3.2.0",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "react-kakao-login": "^2.1.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.7",
    "@playwright/test": "^1.40.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "antigravity-claude-proxy": "^2.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "oh-my-opencode": "github:code-yeongyu/oh-my-opencode#v3.0.0-beta.13",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
