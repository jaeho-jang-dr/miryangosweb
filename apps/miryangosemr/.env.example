# ─── Firebase (Public) ────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=miryangosweb.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=miryangosweb
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=miryangosweb.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Admin SDK (Server-side) ────────────────────
# JSON string of service account key
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── HIRA API (건강보험심사평가원) ───────────────────────
# data.go.kr API key for HIRA public data
HIRA_API_KEY=

# ─── AI / Voice ──────────────────────────────────────────
GEMINI_API_KEY=
GPTOSS_API_KEY=
GPTOSS_BASE_URL=https://api.openai.com/v1
GOOGLE_SPEECH_API_KEY=

# ─── PHI Encryption (의료정보 암호화) ────────────────────
# 64-char hex (256-bit) — MUST be unique per environment
ENCRYPTION_MASTER_KEY=

# ─── App URLs ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://miryangosemr.web.app
NEXT_PUBLIC_WEBSITE_URL=https://miryangosweb.web.app
NEXT_PUBLIC_EMR_URL=https://miryangosemr.web.app
