rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (!hasUserDoc() || getUserRole() == 'admin');
    }

    // 의료법 제23조 역할 기반 접근통제 — EMR 임상 스태프
    // users 문서가 없는 경우(신규 사용자) 인증만 되면 허용
    function isClinicalStaff() {
      return isAuthenticated() &&
        (!hasUserDoc() || getUserRole() in ['admin', 'doctor', 'nurse', 'receptionist', 'billing']);
    }

    function isDoctor() {
      return isAuthenticated() &&
        (!hasUserDoc() || getUserRole() in ['admin', 'doctor']);
    }

    function isBillingStaff() {
      return isAuthenticated() &&
        (!hasUserDoc() || getUserRole() in ['admin', 'billing', 'receptionist']);
    }

    function isNurseOrAbove() {
      return isAuthenticated() &&
        (!hasUserDoc() || getUserRole() in ['admin', 'doctor', 'nurse']);
    }

    // ─── Public Content (Website) ───

    match /notices/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /articles/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /staff/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /inquiries/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // ─── EMR Clinical Data ───

    match /patients/{document=**} {
      allow read, write: if isClinicalStaff();
    }

    match /visits/{document=**} {
      allow read, write: if isClinicalStaff();
    }

    match /appointments/{document=**} {
      allow read, write: if isClinicalStaff();
    }

    match /charts/{document=**} {
      allow read: if isClinicalStaff();
      allow write: if isNurseOrAbove();
    }

    // ─── EMR Billing & Claims ───

    match /billing/{document=**} {
      allow read: if isClinicalStaff();
      allow write: if isBillingStaff();
    }

    match /claims/{document=**} {
      allow read: if isClinicalStaff();
      allow write: if isBillingStaff();
    }

    match /prescriptions/{document=**} {
      allow read: if isClinicalStaff();
      allow write: if isDoctor();
    }

    // ─── EMR Master Data ───

    match /fee_schedule/{document=**} {
      allow read: if isClinicalStaff();
      allow write: if isAdmin();
    }

    match /fee_schedule_items/{document=**} {
      allow read: if isClinicalStaff();
      allow write: if isAdmin();
    }

    match /bundle_prescriptions/{document=**} {
      allow read: if isClinicalStaff();
      allow write: if isAdmin();
    }

    match /doctors/{document=**} {
      allow read: if isClinicalStaff();
      allow write: if isAdmin();
    }

    // ─── EMR Inpatient ───

    match /admissions/{document=**} {
      allow read, write: if isClinicalStaff();
    }

    match /rooms/{document=**} {
      allow read: if isClinicalStaff();
      allow write: if isAdmin();
    }

    // ─── EMR Statistics ───

    match /statistics_daily/{document=**} {
      allow read, write: if isClinicalStaff();
    }

    match /statistics_monthly/{document=**} {
      allow read, write: if isClinicalStaff();
    }

    // ─── System ───

    // 사용자 — 본인 읽기/쓰기, 관리자 전체
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 설정 — 누구나 읽기, 인증된 사용자 쓰기
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 세션 — 본인 관리
    match /sessions/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 백업 로그
    match /backup_logs/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // 서명키 — Admin SDK only
    match /signing_keys/{document=**} {
      allow read, write: if false;
    }

    // 감사 로그 — 인증 사용자 쓰기, 관리자 읽기
    match /audit_logs/{document=**} {
      allow write: if isAuthenticated();
      allow read: if isAdmin();
    }

    // 백업 메타 — Admin only
    match /backup_metadata/{document=**} {
      allow write: if false;
      allow read: if isAdmin();
    }

    // 제증명
    match /certificates/{document=**} {
      allow read, write: if isClinicalStaff();
    }

    // Default: Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
