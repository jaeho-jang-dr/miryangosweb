rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is admin only
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: Clinical staff (admin, manager, operator) — 의료법 제23조 역할 기반 접근통제
    function isClinicalStaff() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'operator'];
    }

    // Public Content (Notices, Archives, Staff)
    // Read: Public
    // Write: Authenticated Only (Admin)
    match /notices/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /articles/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /staff/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Inquiries
    // Create: Public
    // Read/Update/Delete: Authenticated Only (Admin)
    match /inquiries/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Clinical Data (Patients, Visits, Appointments) — 의료법 제23조 접근통제
    // TODO: 개발 완료 후 isClinicalStaff()로 복원
    // Read/Write: 개발 중 임시 허용
    match /patients/{document=**} {
      allow read, write: if true;
    }

    match /visits/{document=**} {
      allow read, write: if true;
    }

    match /appointments/{document=**} {
      allow read, write: if true;
    }

    // Voice Charts — 개발 중 임시 허용
    match /charts/{document=**} {
      allow read, write: if true;
    }

    // Signing Keys — Admin SDK only (server manages keys)
    match /signing_keys/{document=**} {
      allow read, write: if false;  // Only Admin SDK can manage signing keys
    }

    // Audit Logs — Write: Admin SDK only (server-side), Read: Admin/Manager
    match /audit_logs/{document=**} {
      allow write: if false;  // Only Admin SDK can write (bypasses rules)
      allow read: if isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager'];
    }

    // Backup Metadata — Write: Admin SDK only (server-side), Read: Admin only
    match /backup_metadata/{document=**} {
      allow write: if false;  // Only Admin SDK can write (bypasses rules)
      allow read: if isAdmin();
    }

    // Users Collection (Added for Admin Dashboard)
    // Users can read their own data, Admin can manage all users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Settings (Clinic Info)
    // Read: Public
    // Write: Authenticated Only (Admin)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // === EMR Collections (miryangosemr) ===

    // TODO: 개발 완료 후 isClinicalStaff()로 복원
    // Billing Records — 개발 중 임시 허용
    match /billing/{document=**} {
      allow read, write: if true;
    }

    // HIRA Claims — 개발 중 임시 허용
    match /claims/{document=**} {
      allow read, write: if true;
    }

    // Fee Schedule (Master Data) — 개발 중 임시 허용
    match /fee_schedule/{document=**} {
      allow read, write: if true;
    }

    // Prescriptions — 개발 중 임시 허용
    match /prescriptions/{document=**} {
      allow read, write: if true;
    }

    // Statistics (Daily/Monthly) — 개발 중 임시 허용
    match /statistics_daily/{document=**} {
      allow read, write: if true;
    }

    match /statistics_monthly/{document=**} {
      allow read, write: if true;
    }

    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
