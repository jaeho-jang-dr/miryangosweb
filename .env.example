# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=miryangosweb.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=miryangosweb
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=miryangosweb.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Service Account Path (PC-specific)
# Example: C:/Users/YourName/Downloads/miryangosweb-firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# External Tools Paths (PC-specific)
GRAPHICSMAGICK_PATH=C:\\Program Files\\GraphicsMagick-1.3.36-Q16
GHOSTSCRIPT_BIN_PATH=C:\\Program Files\\gs\\gs9.54.0\\bin
GHOSTSCRIPT_LIB_PATH=C:\\Program Files\\gs\\gs9.54.0\\lib

# Noterang Configuration
APIFY_API_KEY=
NOTEBOOKLM_APP_PASSWORD=
# Google Drive path for NotebookLM downloads (PC-specific)
NOTEBOOK_DOWNLOAD_DIR=G:/내 드라이브/notebooklm
# Auth directory for NotebookLM CLI (PC-specific)
NOTEBOOK_AUTH_DIR=

# AI API Keys
GEMINI_API_KEY=
GPTOSS_API_KEY=
GPTOSS_BASE_URL=https://api.openai.com/v1

# PHI Encryption
ENCRYPTION_MASTER_KEY=
